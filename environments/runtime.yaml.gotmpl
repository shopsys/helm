{{/*
Runtime values sourced from environment variables (CI-dynamic and sensitive data).
Everything else belongs to the committed values files. Every block is conditional,
so unset variables never override committed values.
*/}}

{{- if env "TAG" }}
webserver:
  image:
    repository: {{ env "TAG" | quote }}
{{- end }}

{{- if env "STOREFRONT_TAG" }}
storefront:
  image:
    repository: {{ env "STOREFRONT_TAG" | quote }}
{{- end }}

{{- /*
Image pull secret credentials - registry-agnostic (Docker Hub, GHCR, GitLab, Harbor,
GCR/GAR via username "_json_key" + the service account JSON as password, ...).
Generic REGISTRY_* variables take precedence; the GitLab-flavored
CI_REGISTRY/DEPLOY_REGISTER_* names are kept as a fallback for existing pipelines.
*/}}
{{- if env "REGISTRY_SERVER" }}
registry:
  server: {{ env "REGISTRY_SERVER" | quote }}
  username: {{ env "REGISTRY_USERNAME" | quote }}
  password: {{ env "REGISTRY_PASSWORD" | quote }}
  email: {{ env "REGISTRY_EMAIL" | quote }}
{{- else if env "CI_REGISTRY" }}
registry:
  server: {{ env "CI_REGISTRY" | quote }}
  username: {{ env "DEPLOY_REGISTER_USER" | quote }}
  password: {{ env "DEPLOY_REGISTER_PASSWORD" | quote }}
{{- end }}

{{- if env "RABBITMQ_DEFAULT_USER" }}
rabbitmq:
  auth:
    user: {{ env "RABBITMQ_DEFAULT_USER" | quote }}
    password: {{ env "RABBITMQ_DEFAULT_PASS" | quote }}
{{- end }}

{{- /*
HTTP basic auth content: a raw htpasswd file (BASIC_AUTH_PATH) wins; without it the
credentials from HTTP_AUTH_CREDENTIALS ("user:password" - the same variable the website
check uses) let the chart generate the htpasswd entry itself.
*/}}
{{- if env "BASIC_AUTH_PATH" }}
security:
  httpAuth:
    htpasswd: {{ readFile (env "BASIC_AUTH_PATH") | quote }}
{{- else if env "HTTP_AUTH_CREDENTIALS" }}
{{- $credentials := splitn ":" 2 (env "HTTP_AUTH_CREDENTIALS") }}
security:
  httpAuth:
    username: {{ $credentials._0 | quote }}
    password: {{ $credentials._1 | quote }}
{{- end }}

deploy:
{{- if env "DEPLOY_TIMESTAMP" }}
  timestamp: {{ env "DEPLOY_TIMESTAMP" | quote }}
{{- end }}
  firstDeploy:
    enabled: {{ eq (env "FIRST_DEPLOY") "1" }}
    loadDemoData: {{ eq (env "FIRST_DEPLOY_LOAD_DEMO_DATA") "1" }}
