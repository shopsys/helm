{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "environment": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressControllerNamespace": { "type": "object" },
        "monitoringNamespace": { "type": "object" },
        "extraIngress": { "type": "array", "items": { "type": "object" } },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "rules": { "type": "array", "items": { "type": "object" } }
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "config": { "type": "string" },
        "replicas": { "type": "integer", "minimum": 0 }
      }
    },
    "rabbitmq": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "auth": {
          "type": "object",
          "properties": {
            "user": { "type": "string" },
            "password": { "type": "string" }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "storageClass": { "type": "string" },
            "size": { "type": "string" }
          }
        },
        "management": {
          "type": "object",
          "properties": {
            "hostname": { "type": "string" },
            "ipWhitelist": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "deployHooks": {
      "type": "object",
      "properties": {
        "rbac": {
          "type": "object",
          "properties": {
            "create": { "type": "boolean" },
            "serviceAccountName": { "type": "string" }
          }
        }
      }
    }
  }
}
